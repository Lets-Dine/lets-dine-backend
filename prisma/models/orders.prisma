/// §19. A table's order, or a delivery order placed against a phone-number
/// customer instead — `orderType` is the discriminator everything branches
/// on. Every money column is integer minor units and is computed server-side
/// from prices read at checkout — client totals are never trusted (§36/§37).
model Order {
  id                   String      @id @default(uuid()) @map("id") @db.Uuid
  /// Human-readable ticket number, unique inside the restaurant (#1001, #1002…).
  reference            String      @map("reference")
  restaurantId         String      @map("restaurant_id") @db.Uuid
  /// Null for a delivery order — see `orderType`.
  tableId              String?     @map("table_id") @db.Uuid
  sessionId            String      @map("session_id") @db.Uuid
  orderType            OrderType   @default(DINE_IN) @map("order_type")
  /// Set only for a delivery order, placed by a recognised `Customer`.
  customerId           String?     @map("customer_id") @db.Uuid
  status               OrderStatus @default(PENDING) @map("status")
  subtotal             Int         @default(0) @map("subtotal")
  serviceCharge        Int         @default(0) @map("service_charge")
  tax                  Int         @default(0) @map("tax")
  discount             Int         @default(0) @map("discount")
  /// A flat delivery charge folded into the total — §41, read from
  /// `Restaurant.deliveryFeeAmount` at order time and snapshotted here.
  deliveryFee          Int?        @map("delivery_fee")
  total                Int         @default(0) @map("total")
  currency             String      @map("currency")
  /// Snapshots taken at order time — editing the `Customer` row later must
  /// not rewrite a placed order, same reasoning as `OrderItem`'s own snapshots.
  deliveryAddress      String?     @map("delivery_address")
  deliveryPhone        String?     @map("delivery_phone")
  deliveryCustomerName String?     @map("delivery_customer_name")
  deliveryNote         String?     @map("delivery_note")
  /// Floor orders only — snapshotted from `DiningSession.floorVisitorName` at order time,
  /// same reasoning as the delivery snapshots above: editing the session later must not
  /// rewrite a placed order.
  floorVisitorName     String?     @map("floor_visitor_name")
  /// §36 — retrying a placement with the same key returns the first order
  /// instead of creating a second one.
  idempotencyKey       String?     @unique @map("idempotency_key")
  cancelReason         String?     @map("cancel_reason")
  /// §27 — the one remaining whole-order transition staff make by hand; every
  /// other move forward is driven by the items (`OrderItem.status`).
  acceptedAt           DateTime?   @map("accepted_at")
  cancelledAt          DateTime?   @map("cancelled_at")
  completedAt          DateTime?   @map("completed_at")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  createdBy            String?     @map("created_by") @db.Uuid
  updatedBy            String?     @map("updated_by") @db.Uuid

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      DiningTable?  @relation(fields: [tableId], references: [id], onDelete: Restrict)
  session    DiningSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  customer   Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  reviews    DishReview[]

  @@unique([restaurantId, reference])
  @@index([restaurantId, status])
  @@index([restaurantId, orderType])
  @@index([sessionId])
  @@index([tableId, status])
  @@map("orders")
  @@schema("public")
}

enum OrderType {
  DINE_IN
  DELIVERY

  @@schema("public")
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED

  @@schema("public")
}
