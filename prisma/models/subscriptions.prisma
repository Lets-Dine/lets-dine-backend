enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  RESTRICTED
  SUSPENDED
  CANCELLED

  @@schema("public")
}

/// One restaurant's current plan and lifecycle state — exactly one row per restaurant.
model Subscription {
  id                 String             @id @default(uuid()) @map("id") @db.Uuid
  restaurantId       String             @unique @map("restaurant_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(TRIAL) @map("status")
  interval           BillingInterval    @default(MONTHLY) @map("interval")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  /// Drives the PAST_DUE -> RESTRICTED -> SUSPENDED transitions.
  pastDueSince       DateTime?          @map("past_due_since")
  /// A downgrade queued to take effect at the end of the current period.
  pendingPlanId      String?            @map("pending_plan_id") @db.Uuid
  /// Purchased on top of what the plan includes.
  extraBranches      Int                @default(0) @map("extra_branches")
  extraSeats         Int                @default(0) @map("extra_seats")
  cancelledAt        DateTime?          @map("cancelled_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  createdBy          String?            @map("created_by") @db.Uuid
  updatedBy          String?            @map("updated_by") @db.Uuid

  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan        Plan       @relation("SubscriptionPlan", fields: [planId], references: [id], onDelete: Restrict)
  /// The downgrade queued for the end of the period — a plan being retired clears it rather than blocking.
  pendingPlan Plan?      @relation("SubscriptionPendingPlan", fields: [pendingPlanId], references: [id], onDelete: SetNull)
  invoices    Invoice[]

  // The lifecycle job scans by status and period end.
  @@index([status, currentPeriodEnd])
  @@index([planId])
  @@index([pendingPlanId])
  @@map("subscriptions")
  @@schema("public")
}
