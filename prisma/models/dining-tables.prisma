/// §16. A physical table and the opaque token printed on its QR code.
/// Rotating the token invalidates every code already printed for it.
model DiningTable {
  id               String   @id @default(uuid()) @map("id") @db.Uuid
  restaurantId     String   @map("restaurant_id") @db.Uuid
  branchId         String   @map("branch_id") @db.Uuid
  name             String   @map("name")
  qrToken          String   @unique @map("qr_token")
  capacity         Int      @default(2) @map("capacity")
  currentSessionId String?  @map("current_session_id") @db.Uuid
  /// A disabled table stops resolving its QR entirely.
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  createdBy        String?  @map("created_by") @db.Uuid
  updatedBy        String?  @map("updated_by") @db.Uuid

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  currentSession DiningSession?  @relation("CurrentSession", fields: [currentSessionId], references: [id], onDelete: SetNull)
  sessions       DiningSession[] @relation("TableSessions")
  orders         Order[]
  payments       Payment[]

  /// Names are unique per branch — two branches may both have a "Table 1".
  @@unique([branchId, name])
  @@index([restaurantId])
  @@index([branchId])
  @@index([currentSessionId])
  @@map("dining_tables")
  @@schema("public")
}
