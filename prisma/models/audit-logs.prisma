/// §51. A management action worth being able to point at later. Actor name and
/// role are snapshots so the log still reads correctly after someone leaves.
model AuditLog {
  id           String      @id @default(uuid()) @map("id") @db.Uuid
  restaurantId String      @map("restaurant_id") @db.Uuid
  /// Null only until every row is backfilled and the column is tightened.
  branchId     String?     @map("branch_id") @db.Uuid
  actorId      String      @map("actor_id") @db.Uuid
  actorName    String      @map("actor_name")
  actorRole    StaffRole   @map("actor_role")
  action       AuditAction @map("action")
  /// Human-readable target, e.g. "Chicken Sekuwa" or "Order #1023".
  subject      String      @map("subject")
  /// What actually changed — before/after, already formatted for display.
  detail       String      @default("") @map("detail")
  createdAt    DateTime    @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch?    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  actor      User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([restaurantId, createdAt])
  @@index([branchId])
  @@map("audit_logs")
  @@schema("public")
}

enum AuditAction {
  price_changed
  availability_changed
  dish_created
  dish_updated
  dish_archived
  dish_restored
  dish_featured
  dish_reordered
  addon_created
  addon_updated
  addon_archived
  addon_restored
  dish_add_ons_updated
  dish_variant_created
  dish_variant_updated
  dish_variant_archived
  dish_variant_restored
  category_created
  category_renamed
  category_deleted
  category_reordered
  table_created
  table_renamed
  table_disabled
  table_enabled
  table_session_started
  table_session_ended
  qr_regenerated
  floor_created
  floor_renamed
  floor_disabled
  floor_enabled
  branch_created
  branch_updated
  branch_disabled
  branch_enabled
  branch_hours_updated
  order_status_changed
  order_cancelled
  order_item_added
  order_item_removed
  order_item_cancelled
  table_settled
  payment_completed
  settings_updated
  staff_invited
  staff_role_changed
  staff_deactivated
  staff_branches_changed
  ledger_reopened

  @@schema("public")
}
