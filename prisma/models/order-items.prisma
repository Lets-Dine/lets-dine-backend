/// A line on an order. Name, image and unit price are snapshots: editing the
/// dish later must never rewrite what somebody already ordered and paid.
model OrderItem {
  id                   String          @id @default(uuid()) @map("id") @db.Uuid
  orderId              String          @map("order_id") @db.Uuid
  dishId               String          @map("dish_id") @db.Uuid
  dishNameSnapshot     String          @map("dish_name_snapshot")
  imageUrlSnapshot     String?         @map("image_url_snapshot")
  /// The selected DishVariant, if the dish had any. Nullable scalars, not a child
  /// table — cardinality is 0..1, not 0..N like add-ons.
  variantId            String?         @map("variant_id") @db.Uuid
  variantNameSnapshot  String?         @map("variant_name_snapshot")
  variantPriceSnapshot Int?            @map("variant_price_snapshot")
  unitPrice            Int             @map("unit_price")
  quantity             Int             @map("quantity")
  notes                String          @default("") @map("notes")
  /// §20 — the kitchen fires and plates dishes independently; this is the unit
  /// that actually moves through the pass. `Order.status` is derived from these.
  status               OrderItemStatus @default(PENDING) @map("status")
  statusUpdatedAt      DateTime        @default(now()) @map("status_updated_at")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  order   Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish    Dish             @relation(fields: [dishId], references: [id], onDelete: Restrict)
  variant DishVariant?     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  addOns  OrderItemAddOn[]

  @@index([orderId])
  @@index([dishId])
  @@index([variantId])
  @@map("order_items")
  @@schema("public")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED

  @@schema("public")
}
