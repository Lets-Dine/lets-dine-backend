/// §10. A rating of one dish from one completed order. Every review is tied to a
/// purchase — there is no anonymous public review path.
model DishReview {
  id              String   @id @default(uuid()) @map("id") @db.Uuid
  restaurantId    String   @map("restaurant_id") @db.Uuid
  dishId          String   @map("dish_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  overall         Int      @map("overall")
  taste           Int      @map("taste")
  portion         Int      @map("portion")
  value           Int      @map("value")
  wouldOrderAgain Boolean  @default(true) @map("would_order_again")
  comment         String   @default("") @map("comment")
  /// §11 — moderation hides a review without deleting the signal.
  isHidden        Boolean  @default(false) @map("is_hidden")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dish       Dish           @relation(fields: [dishId], references: [id], onDelete: Cascade)
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  session    DiningSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tags       DishReviewTag[]

  /// One review per dish per order — a second attempt is a conflict, not a new row.
  @@unique([orderId, dishId])
  @@index([dishId])
  @@index([restaurantId])
  @@map("dish_reviews")
  @@schema("lets_dine")
}
