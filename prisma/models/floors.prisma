/// §16b. One QR per floor rather than per room — any scan starts its own
/// independent session. Unlike `DiningTable` there is no `currentSessionId`
/// singleton here; that absence is what lets unlimited sessions stay open on
/// the same floor at once.
model Floor {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  name         String   @map("name")
  qrToken      String   @unique @map("qr_token")
  /// A disabled floor stops resolving its QR entirely.
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdBy    String?  @map("created_by") @db.Uuid
  updatedBy    String?  @map("updated_by") @db.Uuid

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sessions   DiningSession[] @relation("FloorSessions")
  orders     Order[]
  payments   Payment[]

  /// Names are unique per branch — two branches may both have a "Ground Floor".
  @@unique([branchId, name])
  @@index([restaurantId])
  @@index([branchId])
  @@map("floors")
  @@schema("public")
}
