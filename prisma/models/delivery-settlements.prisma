enum DeliverySettlementDirection {
  /// The courier handed cash to the branch.
  COLLECT
  /// The branch paid the courier.
  PAYOUT

  @@schema("public")
}

enum DeliverySettlementMethod {
  CASH
  BANK

  @@schema("public")
}

/// Money changing hands with a courier account. `amount` is what actually moves; `offset` is what the
/// same act clears on the other side (fees netted off a collection, cash netted off a payout), so a
/// settle-to-zero leaves both the cash held and the fees owed at zero.
model DeliverySettlement {
  id            String                      @id @default(uuid()) @map("id") @db.Uuid
  restaurantId  String                      @map("restaurant_id") @db.Uuid
  branchId      String                      @map("branch_id") @db.Uuid
  accountKind   DeliveryAccountKind         @map("account_kind")
  accountId     String                      @map("account_id") @db.Uuid
  /// Set when the money was settled as part of settling one delivery order.
  orderId       String?                     @map("order_id") @db.Uuid
  direction     DeliverySettlementDirection @map("direction")
  amount        Int                         @map("amount")
  offset        Int                         @default(0) @map("offset")
  method        DeliverySettlementMethod    @default(CASH) @map("method")
  note          String                      @default("") @map("note")
  createdAt     DateTime                    @default(now()) @map("created_at")
  createdBy     String?                     @map("created_by") @db.Uuid
  createdByName String?                     @map("created_by_name")

  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order         Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  /// The cash-book rows this settlement posted.
  ledgerEntries Expense[]

  @@index([branchId, createdAt])
  @@index([orderId])
  @@index([accountKind, accountId, createdAt])
  @@map("delivery_settlements")
  @@schema("public")
}
