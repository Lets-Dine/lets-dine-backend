/// A staff phone that can receive push notifications. One row per FCM token: a shared restaurant phone is re-registered
/// by whoever signs in next, so the token always belongs to the person using it now.
model DeviceToken {
  id           String   @id @default(uuid()) @map("id") @db.Uuid
  token        String   @unique @map("token")
  memberId     String   @map("member_id") @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  /// The branch the member is working in on that phone, not every branch they belong to (an owner reaches all of them).
  branchId     String   @map("branch_id") @db.Uuid
  platform     String   @map("platform")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  member RestaurantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([restaurantId, branchId])
  @@index([memberId])
  @@map("device_tokens")
  @@schema("public")
}
