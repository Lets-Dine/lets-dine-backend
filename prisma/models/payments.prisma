/// How a settled charge was actually taken — CARD stands in for anything
/// taken off-cash (card machine today, a real gateway later).
enum PaymentMethod {
  CASH
  CARD
  /// A scanned wallet / bank QR (Fonepay and the like). Lands in the bank, like CARD.
  QR

  @@schema("public")
}

/// How much of a sale has been collected. Derived from `Payment.paidAmount` against `total`, kept in
/// step by the same write, so a list can filter on it.
enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID

  @@schema("public")
}

/// A collection attempt. Only SUCCEEDED ones count as money received; PENDING/FAILED are the attempt.
enum TenderStatus {
  PENDING
  SUCCEEDED
  FAILED

  @@schema("public")
}

/// A completed charge against one dining session — snapshotting exactly what
/// the cashier charged for rather than re-deriving it from whatever the
/// underlying orders happen to look like later.
model Payment {
  id              String        @id @default(uuid()) @map("id") @db.Uuid
  restaurantId    String        @map("restaurant_id") @db.Uuid
  branchId        String        @map("branch_id") @db.Uuid
  sessionId       String        @map("session_id") @db.Uuid
  /// Null for a delivery order settled individually — nothing to batch by table.
  tableId         String?       @map("table_id") @db.Uuid
  /// §16b — set only for a floor order's own bill, same reasoning as `Order.floorId`.
  floorId         String?       @map("floor_id") @db.Uuid
  subtotal        Int           @map("subtotal")
  serviceCharge   Int           @map("service_charge")
  tax             Int           @map("tax")
  /// Who paid: a floor payment's own order's customer, otherwise the visit's customer — a delivery
  /// session's own, or the customer the table session's orders were placed under. Null when the
  /// diner never gave a number.
  customerId      String?       @map("customer_id") @db.Uuid
  discount        Int           @default(0) @map("discount")
  /// The part of `discount` that redeemed loyalty points paid for, snapshotted so a later rate change
  /// never rewrites what this bill was worth.
  loyaltyDiscount Int           @default(0) @map("loyalty_discount")
  total           Int           @map("total")
  method          PaymentMethod @default(CASH) @map("method")
  currency        String        @map("currency")
  createdAt       DateTime      @default(now()) @map("created_at")
  /// Collected so far (sum of SUCCEEDED tenders). Outstanding is `total - paidAmount`. A DB check keeps it within [0, total].
  paidAmount      Int           @default(0) @map("paid_amount")
  /// Handed back so far (sum of refunds). Never above `paidAmount`; the original payment and its tenders are never edited.
  refundedAmount  Int           @default(0) @map("refunded_amount")
  paymentStatus   PaymentStatus @default(UNPAID) @map("payment_status")
  /// When the unpaid part is expected, for a credit sale.
  dueDate         DateTime?     @map("due_date")
  /// Client-sent retry key: the same key for the same restaurant returns the first result instead of a second sale.
  idempotencyKey  String?       @map("idempotency_key")
  createdBy       String?       @map("created_by") @db.Uuid
  /// Snapshot of the staff member's name at the moment of payment — same
  /// reasoning as `AuditLog.actorName`, so the receipt still reads right
  /// after that person is renamed or removed.
  createdByName   String?       @map("created_by_name")

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  session        DiningSession  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  table          DiningTable?   @relation(fields: [tableId], references: [id], onDelete: Restrict)
  floor          Floor?         @relation(fields: [floorId], references: [id], onDelete: Restrict)
  customer       Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items          PaymentItem[]
  loyaltyEntries LoyaltyEntry[]
  tenders        PaymentTender[]
  refunds        PaymentRefund[]

  @@unique([restaurantId, idempotencyKey])
  @@index([branchId, paymentStatus])
  @@index([restaurantId, createdAt])
  @@index([branchId])
  @@index([sessionId])
  @@index([floorId])
  @@index([customerId])
  // The customers list aggregates a branch's payments per customer.
  @@index([branchId, customerId])
  @@map("payments")
  @@schema("public")
}

/// One charged line, snapshotted at payment time — immune to the dish's price
/// or name changing later, the same reasoning as `OrderItem`'s own snapshot.
/// Defined by the cashier at checkout, not derived from any one order's rows.
model PaymentItem {
  id               String   @id @default(uuid()) @map("id") @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  dishId           String   @map("dish_id") @db.Uuid
  dishNameSnapshot String   @map("dish_name_snapshot")
  unitPrice        Int      @map("unit_price")
  quantity         Int      @map("quantity")
  createdAt        DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_items")
  @@schema("public")
}

/// One collection against a sale: a split bill is several of these, a credit sale starts with none
/// and gains one per later settlement. The cash book reads money in from here, never from `Payment.total`.
model PaymentTender {
  id             String        @id @default(uuid()) @map("id") @db.Uuid
  restaurantId   String        @map("restaurant_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  paymentId      String        @map("payment_id") @db.Uuid
  amount         Int           @map("amount")
  method         PaymentMethod @map("method")
  status         TenderStatus  @default(SUCCEEDED) @map("status")
  /// Receipt / wallet / gateway reference.
  reference      String        @default("") @map("reference")
  /// Retry key, unique per restaurant: a replayed request finds this row instead of collecting twice.
  idempotencyKey String?       @map("idempotency_key")
  paidAt         DateTime      @default(now()) @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  createdBy      String?       @map("created_by") @db.Uuid
  createdByName  String?       @map("created_by_name")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, idempotencyKey])
  @@index([paymentId])
  @@index([branchId, paidAt])
  @@map("payment_tenders")
  @@schema("public")
}

/// Money handed back against a sale. Its cash-book outflow is the `Expense` row carrying this id.
model PaymentRefund {
  id             String        @id @default(uuid()) @map("id") @db.Uuid
  restaurantId   String        @map("restaurant_id") @db.Uuid
  branchId       String        @map("branch_id") @db.Uuid
  paymentId      String        @map("payment_id") @db.Uuid
  /// The collection being reversed, when the refund is tied to one.
  tenderId       String?       @map("tender_id") @db.Uuid
  amount         Int           @map("amount")
  method         PaymentMethod @map("method")
  reason         String        @default("") @map("reason")
  idempotencyKey String?       @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  createdBy      String?       @map("created_by") @db.Uuid
  createdByName  String?       @map("created_by_name")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([restaurantId, idempotencyKey])
  @@index([paymentId])
  @@index([branchId, createdAt])
  @@map("payment_refunds")
  @@schema("public")
}
