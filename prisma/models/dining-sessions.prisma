/// §21/§22. One diner's visit — to a table (QR-scanned) or as a delivery
/// customer (phone-identified). The token is the diner's whole identity — no
/// account, no personal data beyond what delivery already needs.
model DiningSession {
  id                    String    @id @default(uuid()) @map("id") @db.Uuid
  restaurantId          String    @map("restaurant_id") @db.Uuid
  /// Null for a delivery or floor session — `customerId`/`floorId` is set instead.
  tableId               String?   @map("table_id") @db.Uuid
  /// Set only for a delivery session. A floor order's own `Customer` is
  /// attached to the `Order` instead, captured at order time (§16b).
  customerId            String?   @map("customer_id") @db.Uuid
  /// Set only for a floor session (§16b) — deliberately has no uniqueness
  /// constraint analogous to `dining_sessions_one_open_per_table_idx`, so any
  /// number of these can stay open on the same floor at once.
  floorId               String?   @map("floor_id") @db.Uuid
  /// Legacy — floor sessions used to collect this up front; identity is now
  /// captured per order instead (see `Order.floorVisitorName`).
  floorVisitorName      String?   @map("floor_visitor_name")
  anonymousSessionToken String    @unique @map("anonymous_session_token")
  startedAt             DateTime  @default(now()) @map("started_at")
  expiresAt             DateTime  @map("expires_at")
  endedAt               DateTime? @map("ended_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table        DiningTable?  @relation("TableSessions", fields: [tableId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  floor        Floor?        @relation("FloorSessions", fields: [floorId], references: [id], onDelete: Cascade)
  orders       Order[]
  reviews      DishReview[]
  payments     Payment[]
  /// Tables that currently have this visit parked as `currentSession`.
  diningTables DiningTable[] @relation("CurrentSession")

  /// Partial uniqueness for open sessions is enforced by
  /// `dining_sessions_one_open_per_table_idx` in SQL. No floor equivalent exists on purpose (§16b).
  @@index([restaurantId, tableId])
  @@index([restaurantId, floorId])
  @@map("dining_sessions")
  @@schema("public")
}
