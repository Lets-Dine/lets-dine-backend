{
  "extends": "{scope}/core/tsconfig-base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "sourceMap": true,
    "isolatedModules": false,
    "allowJs": true,
    "types": ["node", "jest"]
  },
  "include": ["./src/**/*"],
  "exclude": ["./dist", "./node_modules"]
}
