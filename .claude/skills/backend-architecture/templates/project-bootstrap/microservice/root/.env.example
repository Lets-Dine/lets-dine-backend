NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME={project-name}
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema={service-name}"

# Set either to "false" to silence it. Both default to on. Shared by every service.
LOG_HTTP_REQUESTS=true
LOG_PRISMA_QUERIES=true

REDIS_HOST=localhost
REDIS_PORT=6379

NATS_URL=nats://localhost:4222
