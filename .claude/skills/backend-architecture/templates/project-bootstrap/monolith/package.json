{
  "name": "{project-name}",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --debug 0.0.0.0:9229 --watch 'node --inspect-brk'",
    "dev:once": "nest start --debug 0.0.0.0:9229 'node --inspect-brk'",
    "lint": "biome ci src/",
    "lint:fix": "biome check --write src/",
    "test": "jest --passWithNoTests --verbose",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "./prisma"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.1.12",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.0.0",
    "nestjs-zod": "^4.3.1",
    "zod": "^3.24.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "dotenv": "^16.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "5.8.2"
  }
}
