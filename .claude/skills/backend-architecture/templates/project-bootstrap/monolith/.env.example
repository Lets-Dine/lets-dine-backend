NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_NAME={project-name}
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema={project-name}"

# Set either to "false" to silence it. Both default to on.
LOG_HTTP_REQUESTS=true
LOG_PRISMA_QUERIES=true

# Drop these if the project has no caching/queue needs
REDIS_HOST=localhost
REDIS_PORT=6379
