# Published host ports are deliberately off the usual 3000/5432/6379 so this
# project can run alongside another backend stack on the same machine.
NODE_ENV=development
APP_NAME=lets-dine
PORT=3100

DB_HOST=localhost
DB_PORT=5442
DB_NAME=lets_dine
DB_USERNAME=postgres
DB_PASSWORD=postgres
DATABASE_URL="postgresql://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}"

# Platform onboarding (§4.4) — the shared key POST /platform/restaurants expects
# in an x-platform-key header. Leave unset to disable the endpoints entirely.
PLATFORM_ADMIN_KEY=change-me-too

# Staff (restaurant dashboard) authentication
JWT_SECRET=change-me-in-every-real-environment
JWT_EXPIRES_IN=7d

# How long a diner's QR-scanned table session stays valid, in minutes (§21).
DINING_SESSION_TTL_MINUTES=180

# Seeding: SEED_DEMO=false seeds only the review-tag vocabulary, no demo restaurant.
SEED_DEMO=true
SEED_DEMO_PIN=4821
# SEED_HISTORY=false leaves the demo restaurant with no orders or reviews,
# so the app's empty states are what you see.
SEED_HISTORY=true

# Set either to "false" to silence it. Both default to on.
LOG_HTTP_REQUESTS=true
LOG_PRISMA_QUERIES=true

# Drop these if the project has no caching/queue needs
REDIS_HOST=localhost
REDIS_PORT=6389

# Signed direct-to-Cloudinary uploads (dish photos, restaurant cover image).
# POST /restaurant/uploads/signature returns 400 until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Billing scheduler — the daily cycle that issues renewal invoices and moves unpaid
# subscriptions along their lifecycle. Runs inside the app process, so with several
# instances set BILLING_SCHEDULER_ENABLED=false on all but one.
BILLING_SCHEDULER_ENABLED=true
BILLING_CRON="0 2 * * *"
BILLING_CRON_TIMEZONE=Asia/Kathmandu

# Fonepay dynamic QR. Merchant credentials are per restaurant (PUT /restaurant/fonepay),
# stored with the secrets encrypted by this key: generate with `openssl rand -hex 32`.
# FONEPAY_ENV=live hits production; anything else uses the dev merchant API.
SECRETS_ENCRYPTION_KEY=
FONEPAY_ENV=dev
# Saving a restaurant's Fonepay details first asks Fonepay for a test QR to prove they work.
# Set false to skip that (offline dev, or no merchant account to test with).
FONEPAY_VERIFY_ON_SAVE=true
